{
  "name": "Robotaxi thesis lab",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "web/app/page.tsx"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "postCreateCommand": "cd web && npm ci",
  "postAttachCommand": {
    "server": "cd web && npm run dev -- --hostname 0.0.0.0"
  },
  "portsAttributes": {
    "3000": {
      "label": "Robotaxi thesis lab",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    3000
  ]
}
